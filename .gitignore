# Credentials and machine-local configuration
.credentials.yaml
.anonymous-user-id
.env
.env.*
settings.yaml
local/
.dsh/

# Runtime state: keep locally, never commit by default
sessions/
storages/
memories/
task-board/
pet.json
skin-center-active.json
wsl-workspaces.json
*.log
# Rotated launcher logs produced by scripts/launch-windows.ps1
dsh-web.*.log.*.bak

# Machine-local scratch and session artifacts
.tools/
attachments/
.think-slice-backups/

# WSL preset variants: regenerated by dsh-wsl-workspace on every Windows boot;
# machine-local artifacts, never synced (Linux has no WSL)
.agent-presets/wsl-*/

# dsh-reef panel runtime settings (may hold tokens); stays local
.dsh-reef/

# Generated profile state and dependencies
**/node_modules/
.pnpm-store/
profiles/*/.dsh-market/
profiles/*/cordis.yml
profiles/*/*.bak-*

# Wallpaper cache is reproducible; wallpaper sources and uploads are tracked
skin-center/wallpapers/.cache/

# Build/test noise
coverage/
.cache/
**/dist/
**/build/
**/out/
**/.output/
**/.next/
**/.nuxt/
*.tsbuildinfo
*.py[cod]
__pycache__/
*.tmp
*.swp
.DS_Store
Thumbs.db
