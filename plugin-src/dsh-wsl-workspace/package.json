{
  "name": "dsh-wsl-workspace",
  "description": "本地 fork（基于上游 0.3.1）：修复 materializeVariants 以绝对路径改写 .agent-presets/wsl-* 行路径的问题——改为相对 variant 目录的相对路径，生成物跨机器一致。仅 Windows 端经 config/cordis.patch.windows.yml 注册。",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6Mikao9/dsh-wsl-workspace.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./shell": "./lib/shell.js",
    "./fs": "./lib/fs.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.7"
  }
}
