{
  "name": "dsh-fork-to-preset",
  "version": "0.1.1",
  "description": "Fork any session into a different agent preset — a UI button with preset picker in the conversation header.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "agent-preset",
    "fork",
    "multi-agent"
  ],
  "author": "bpc-oss",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpc-oss/dsh-fork-to-preset.git"
  },
  "homepage": "https://github.com/bpc-oss/dsh-fork-to-preset",
  "bugs": {
    "url": "https://github.com/bpc-oss/dsh-fork-to-preset/issues"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    ".gitignore"
  ]
}
